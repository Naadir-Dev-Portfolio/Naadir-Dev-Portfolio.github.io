{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naadir-portfolio-analytics",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naadir-portfolio-analytics-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
