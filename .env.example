# Copy this file to .env and fill in the values from your Cloudflare dashboard.
# .env is already ignored by Git. Never commit the real token.
CLOUDFLARE_ACCOUNT_ID=replace_with_32_character_account_id
CLOUDFLARE_DATABASE_ID=replace_with_d1_database_uuid
CLOUDFLARE_D1_TOKEN=replace_with_read_only_d1_api_token
